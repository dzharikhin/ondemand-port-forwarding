# --- required (5) ---
# IMAP_PASSWORD, SECRET (and optional SMTP_PASSWORD, PLAINTEXT_CODE) can be
# omitted here and typed in at launch instead — see README "Launch with
# secrets typed in"
IMAP_HOST=imap.example.com
IMAP_USER=user@example.com
IMAP_PASSWORD=changeme
SMTP_HOST=smtp.example.com
# gpg symmetric passphrase for command letters; also used by `ondemandportforward encrypt`
SECRET=long-random-passphrase

# --- optional ---
#IMAP_PORT=993
# mailbox(es) the daemon watches, comma-separated. With From-validation off,
# letters may arrive in different folders, e.g. both plain INBOX (mail from
# others) and the self-sent folder: IMAP_MAILBOX=INBOX,INBOX/ToMyself
# mail.ru sorts self-sent mail into INBOX/ToMyself — include it in the list
#IMAP_MAILBOX=INBOX
#SMTP_PORT=465
#SMTP_USER=            # default: IMAP_USER
#SMTP_PASSWORD=        # default: IMAP_PASSWORD
#MAIL_FROM=            # default: SMTP_USER
# seed for one-time plaintext code (only applies if none armed in store);
# prefer `docker compose run --rm ondemandportforward set-code` instead
#PLAINTEXT_CODE=
#TTL_DEFAULT=1800
#RETRIES=3
#LOG_RETENTION_DAYS=90
#STRICT_HEADERS=0
#POLL_INTERVAL=60
#CONNECT_GRACE=10
#DATA_DIR=./data
