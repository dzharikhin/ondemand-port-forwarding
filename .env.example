# --- required (5) ---
IMAP_HOST=imap.example.com
IMAP_USER=user@example.com
IMAP_PASSWORD=changeme
SMTP_HOST=smtp.example.com
# gpg symmetric passphrase for command letters; also used by `ondemandportforward encrypt`
SECRET=long-random-passphrase

# --- optional ---
#IMAP_PORT=993
#SMTP_PORT=465
#SMTP_USER=            # default: IMAP_USER
#SMTP_PASSWORD=        # default: IMAP_PASSWORD
#MAIL_FROM=            # default: SMTP_USER
# seed for one-time plaintext code (only applies if none armed in store);
# prefer `docker compose run --rm ondemandportforward set-code` instead
#PLAINTEXT_CODE=
#TTL_DEFAULT=1800
#RETRIES=3
#LOG_RETENTION_DAYS=90
#STRICT_HEADERS=0
#POLL_INTERVAL=60
#CONNECT_GRACE=10
# target side of -R forwards ("localhost" = this container itself!);
# compose sets it to host.docker.internal so tunnels reach the host machine
#INTERNAL_HOST=host.docker.internal
#DATA_DIR=./data
